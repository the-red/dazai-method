# Do not share your OpenAI API key with anyone! It should remain a secret.
OPENAI_API_KEY=

# LINE Messaging API（LINE Developers コンソール > チャネル基本設定 / Messaging API 設定）
# Webhook の署名検証とメッセージ返信に使う。LINE Bot を動かさない場合は空のままでよい
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Analytics 4 の測定 ID（GA 管理画面 > データストリーム > 測定 ID。G- で始まる）
# 未設定ならタグを埋め込まない。ローカルでは空のままでよい
NEXT_PUBLIC_GA_MEASUREMENT_ID=
